# Domínio público apontando para o servidor (o Caddy emite o certificado HTTPS).
ARCO_DOMAIN=arco.seudominio.com

# Hash BCrypt da sua senha. Gere com:
#   dotnet run --project src/Arco.Api -- hash-password "sua-senha"
# Coloque o hash entre aspas simples: ele contém "$".
ARCO_PASSWORD_HASH='$2a$11$...'
